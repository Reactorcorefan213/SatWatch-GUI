<Window x:Class="SatWatch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="900" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Width="80" Margin="4"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Margin="4"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="10">
                    <TextBlock Text="Maidenhead Locator (4/6/8):"/>
                    <TextBox x:Name="MaidenBox" Margin="0,4,0,10"/>
                    <TextBlock Text="TLE Update URL:"/>
                    <TextBox x:Name="TleUrlBox" Margin="0,4,0,10"/>
                    <TextBlock Text="Update every (days):"/>
                    <TextBox x:Name="TleDaysBox" Margin="0,4,0,10"/>
                    <CheckBox x:Name="AutoUpdateBox" Content="Auto-update TLE" Margin="0,4,0,10"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Satellites">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="SatList" Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="NewSatName" Width="120" Margin="4,0" ToolTip="Name"/>
                        <TextBox x:Name="NewSatNorad" Width="70" Margin="4,0" ToolTip="NORAD"/>
                        <TextBox x:Name="NewSatTle1" Width="260" Margin="4,0" ToolTip="TLE line 1"/>
                        <TextBox x:Name="NewSatTle2" Width="260" Margin="4,0" ToolTip="TLE line 2"/>
                        <Button Content="Add" Click="AddSat_Click" Margin="4,0"/>
                        <Button Content="Remove" Click="RemoveSat_Click" Margin="4,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Alarms">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="AlarmList" Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="AlarmSatBox" Width="120" Margin="4,0"/>
                        <ComboBox x:Name="AlarmMilestoneBox" Width="70" Margin="4,0"/>
                        <TextBox x:Name="AlarmOffsetBox" Width="50" Margin="4,0" Text="0"/>
                        <ComboBox x:Name="AlarmActionBox" Width="70" Margin="4,0"/>
                        <TextBox x:Name="AlarmAudioBox" Width="140" Margin="4,0" ToolTip="Audio path"/>
                        <TextBox x:Name="AlarmScriptBox" Width="140" Margin="4,0" ToolTip="Script path"/>
                        <Button Content="Add" Click="AddAlarm_Click" Margin="4,0"/>
                        <Button Content="Remove" Click="RemoveAlarm_Click" Margin="4,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
