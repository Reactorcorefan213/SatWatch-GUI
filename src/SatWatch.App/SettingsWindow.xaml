<Window x:Class="SatWatch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="700" Width="1000" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" IsDefault="True" Click="Ok_Click" Width="90" Margin="4" Padding="8,4"/>
            <Button Content="Cancel" IsCancel="True" Width="90" Margin="4" Padding="8,4"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="16" MaxWidth="600">
                    <TextBlock Text="Maidenhead Locator" FontWeight="Bold"/>
                    <TextBlock Text="4, 6, or 8 characters (e.g. FN20ab)" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                    <TextBox x:Name="MaidenBox" Margin="0,0,0,12"/>
                    <TextBlock Text="TLE Update URL" FontWeight="Bold"/>
                    <TextBox x:Name="TleUrlBox" Margin="0,0,0,12"/>
                    <TextBlock Text="Update interval (days)" FontWeight="Bold"/>
                    <TextBox x:Name="TleDaysBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <CheckBox x:Name="AutoUpdateBox" Content="Automatically update TLEs" Margin="0,0,0,12"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Satellites">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Favorites" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <ListBox x:Name="SatList" Margin="6"/>
                    </GroupBox>
                    <TabControl Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                        <TabItem Header="Manual">
                            <StackPanel Margin="8">
                                <TextBlock Text="Name" FontWeight="Bold"/>
                                <TextBox x:Name="NewSatName" Margin="0,2,0,8"/>
                                <TextBlock Text="NORAD ID" FontWeight="Bold"/>
                                <TextBox x:Name="NewSatNorad" Margin="0,2,0,8"/>
                                <TextBlock Text="TLE Line 1" FontWeight="Bold"/>
                                <TextBox x:Name="NewSatTle1" Margin="0,2,0,8"/>
                                <TextBlock Text="TLE Line 2" FontWeight="Bold"/>
                                <TextBox x:Name="NewSatTle2" Margin="0,2,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Add Satellite" Click="AddSat_Click" Padding="8,4" Margin="0,0,6,0"/>
                                    <Button Content="Remove Selected" Click="RemoveSat_Click" Padding="8,4"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Browse TLEs">
                            <StackPanel Margin="8">
                                <TextBlock Text="Source" FontWeight="Bold"/>
                                <ComboBox x:Name="TleSourceBox" Margin="0,2,0,8"/>
                                <Button x:Name="FetchTleList" Content="Fetch List" Click="FetchTleList_Click" Padding="8,4" Margin="0,0,0,8"/>
                                <TextBlock Text="Search" FontWeight="Bold"/>
                                <TextBox x:Name="TleSearchBox" Margin="0,2,0,8" TextChanged="TleSearchBox_TextChanged"/>
                                <ListBox x:Name="TleBrowseList" Height="260" Margin="0,0,0,8"/>
                                <Button Content="Add Selected to Favorites" Click="AddBrowsed_Click" Padding="8,4"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Tip: use Browse to download amateur radio and other groups from Celestrak." Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Alarms">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Alarm Rules" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <ListBox x:Name="AlarmList" Margin="6"/>
                    </GroupBox>
                    <GroupBox Header="Add Alarm Rule" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="Satellite" FontWeight="Bold"/>
                            <ComboBox x:Name="AlarmSatBox" Margin="0,2,0,8"/>
                            <TextBlock Text="Milestone" FontWeight="Bold"/>
                            <ComboBox x:Name="AlarmMilestoneBox" Margin="0,2,0,8"/>
                            <TextBlock Text="Offset (seconds, negative = before)" FontWeight="Bold"/>
                            <TextBox x:Name="AlarmOffsetBox" Text="0" Margin="0,2,0,8"/>
                            <TextBlock Text="Action" FontWeight="Bold"/>
                            <ComboBox x:Name="AlarmActionBox" Margin="0,2,0,8"/>
                            <TextBlock Text="Audio file (.wav/.mp3)" FontWeight="Bold"/>
                            <TextBox x:Name="AlarmAudioBox" Margin="0,2,0,8"/>
                            <TextBlock Text="Script file (.bat/.ps1/.exe)" FontWeight="Bold"/>
                            <TextBox x:Name="AlarmScriptBox" Margin="0,2,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Rule" Click="AddAlarm_Click" Padding="8,4" Margin="0,0,6,0"/>
                                <Button Content="Remove Selected" Click="RemoveAlarm_Click" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Triggers fire when current time is within 3s of milestone + offset." Foreground="Gray" FontSize="11" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
