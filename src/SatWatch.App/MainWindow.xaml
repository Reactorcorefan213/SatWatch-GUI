<Window x:Class="SatWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SatWatch" Height="760" Width="1320" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Background="{DynamicResource PanelBg}" Padding="6" Margin="0,0,8,0">
            <Grid Background="Black" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/earth.jpg" Stretch="Uniform" x:Name="EarthImage"/>
                <Canvas x:Name="Overlay" Width="1024" Height="512" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Background="{DynamicResource PanelBg}" Padding="10">
            <StackPanel>
                <TextBlock Text="Upcoming Passes" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <ListBox x:Name="PassList" BorderThickness="0" Background="Transparent"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="12" Background="{DynamicResource PanelBg}" Padding="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Text="Imagery © NASA (Blue Marble)" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource SubtleFg}" FontSize="10"/>
                <Button Content="Settings" Click="Settings_Click" Margin="8,0"/>
                <Button Content="Update TLE" Click="UpdateTle_Click" Margin="8,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
